# ============================================
# SiteLens Feature Flags
# Copy this file to .env and adjust as needed
# ============================================

# ── Core Features (default: true) ──────────────
VITE_FEATURE_ELEMENT_INSPECTOR=true
VITE_FEATURE_COLOR_EXTRACTION=true
VITE_FEATURE_TYPOGRAPHY_ANALYSIS=true
VITE_FEATURE_FLOATING_WINDOW=true

# ── Advanced Features (default: true) ──────────
VITE_FEATURE_SIDE_PANEL=true
VITE_FEATURE_ADVANCED_INSPECTOR=true
VITE_FEATURE_ASSET_GALLERY=true
VITE_FEATURE_GRADIENT_EXTRACTION=true
VITE_FEATURE_DOMAIN_INSIGHTS=true
VITE_FEATURE_STACK_DETECTION=true
VITE_FEATURE_MEASUREMENT_OVERLAY=true
